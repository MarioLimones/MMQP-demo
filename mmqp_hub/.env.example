APP_NAME="MMQP Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

DEMO_MODE=true
DEMO_SETUP=1
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=single
LOG_LEVEL=warning

# scripts/prepare-demo.php replaces this with the absolute demo-only path.
DB_CONNECTION=sqlite
DB_DATABASE=database/demo.sqlite
DB_URL=
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# The demo never sends real mail or push notifications.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=demo@mmqp.example
MAIL_FROM_NAME="MMQP Demo"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Local setup writes paths for algoritmo/venv automatically when it exists.
PYTHON_PATH=python
CONSUMO_PDF_PYTHON=python
VITE_APP_NAME="MMQP Demo"
